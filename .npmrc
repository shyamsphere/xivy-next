# Medusa generates an admin entry that imports @medusajs/dashboard without
# it being a declared dependency, so these must resolve from the root
# node_modules or `medusa build` fails. Targeted rather than
# shamefully-hoist=true, which additionally flattens @types/react and breaks
# the storefront's React 19 typing.
public-hoist-pattern[]=*@medusajs/*
public-hoist-pattern[]=@tanstack/react-query
public-hoist-pattern[]=react-i18next
public-hoist-pattern[]=react-router-dom
